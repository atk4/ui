parameters:
    level: 6
    checkMissingOverrideMethodAttribute: true
    paths:
        - tests/CallbackTest.php
    excludePaths:
        - vendor
        - js

    ignoreErrors:
        # relax strict rules
        - '~^Only booleans are allowed in .+, .+ given( on the (left|right) side)?\.$~'
        - '~^Variable (static )?(property access|method call) on .+\.$~'
